yolov8x.pt filter=lfs diff=lfs merge=lfs -text
# Default: Textdateien normalisieren
* text=auto

# Python / Code immer LF
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.csv text eol=lf

# PowerShell / Windows-Skripte optional CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binärdateien nicht anfassen
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.mp4 binary
*.avi binary
*.mov binary
*.mkv binary
*.zip binary
*.sqlite binary
*.sqlite3 binary
*.db binary
*.pt binary
*.pth binary
*.onnx binary